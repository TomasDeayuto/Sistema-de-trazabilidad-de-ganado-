#include <MCUFRIEND_kbv.h>
#include <Adafruit_GFX.h>
#include <TouchScreen.h>

MCUFRIEND_kbv tft;

#define BLACK   0x0000
#define BLUE    0x001F
#define RED     0xF800
#define GREEN   0x07E0
#define CYAN    0x07FF
#define MAGENTA 0xF81F
#define YELLOW  0xFFE0
#define WHITE   0xFFFF

#define XP 6
#define XM A2
#define YP A1
#define YM 7

TouchScreen ts = TouchScreen(XP, YP, XM, YM, 300);
#define MINPRESSURE 10
#define MAXPRESSURE 1000
void setup() {
  Serial.begin(9600);
  uint16_t ID = tft.readID();
  Serial.print("ID: 0x");
  Serial.println(ID, HEX);
  tft.begin(0x9486);
  tft.setRotation(1);
  tft.fillScreen(BLACK);
  tft.setTextColor(WHITE);
  tft.setTextSize(3);
  tft.setCursor(80, 20);
  tft.println("PRUEBA");
  Serial.println("TOUCH LISTO");
}
void loop() {
  TSPoint p = ts.getPoint();
  pinMode(XM, OUTPUT);
  pinMode(YP, OUTPUT);
  if (p.z > MINPRESSURE && p.z < MAXPRESSURE) {
    int x = map(p.y, 958, 168, 0, 480);
    int y = map(p.x, 172, 930, 0, 320);
    x = constrain(x, 0, 479);
    y = constrain(y, 0, 319);
    Serial.print("X = ");
    Serial.print(x);
    Serial.print("   Y = ");
    Serial.print(y);
    Serial.print("   Z = ");
    Serial.println(p.z);
    tft.fillCircle(x, y, 5, RED);
    delay(50);
  }
}
